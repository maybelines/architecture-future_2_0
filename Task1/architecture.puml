@startuml
!include <C4/C4_Container>

title Будущее 2.0 — целевая архитектура через год\nC4: диаграмма контейнеров
skinparam defaultFontName Noto Sans
skinparam shadowing false
skinparam legendFontColor #333333
skinparam legendBackgroundColor #F5F5F5

Person(operator, "Сотрудник клиники", "Ведёт приём и работает с медицинскими данными")
Person(analyst, "Руководитель / аналитик", "Получает показатели и создаёт отчёты в пределах своих прав")

System_Boundary(company, "ИТ-система «Будущее 2.0»") {
    Boundary(medicine, "Медицина — отдельная среда") {
        Container(desktop, "Интерфейс клиники", "PowerBuilder, настольное приложение", "Сохраняется на переходный период")
        Container(med_api, "Медицинское приложение", ".NET, HTTPS API", "Работа клиник и медицинская бизнес-логика [С4]")
        ContainerDb(med_db, "Медицинская БД", "SQL Server, поддерживаемая версия", "Карты, истории болезни, исследования, учёт услуг")
        ContainerDb(images, "Хранилище снимков", "S3-совместимое объектное хранилище", "Медицинские изображения; закрытый доступ")
    }

    Boundary(finance, "Финтех — отдельная среда") {
        Container(fin_api, "Финтех-приложение", "Go / Java, HTTPS API", "Счета, платежи, кредиты; независимые релизы [С2]")
        ContainerDb(fin_db, "БД финтеха", "PostgreSQL", "Финансовая история и операции")
    }

    Boundary(ai, "ИИ — отдельная среда") {
        Container(ai_api, "ИИ-приложение", "Python, HTTPS API", "Обработка медицинских данных; независимые релизы [С2]")
        ContainerDb(ai_db, "БД ИИ", "PostgreSQL", "Задания, результаты обработки и учёт использования")
    }

    Boundary(office, "Головной офис — отдельная среда") {
        Container(office_api, "Внутреннее приложение", "Java, HTTPS API", "Персонал, инвентаризация, внутренние финансы")
        ContainerDb(office_db, "БД головного офиса", "PostgreSQL", "Корпоративные учётные данные")
    }

    Boundary(analytics, "Общая аналитика — отдельная среда") {
        Container(loader, "Загрузка данных", "Apache Camel", "Проверка разрешённых полей и загрузка изменений по расписанию")
        ContainerDb(dwh, "Аналитическое хранилище", "ClickHouse", "Отчётные данные и готовые витрины; без клинических сведений [С1]")
        Container(bi, "Портал самообслуживания", "Power BI", "Готовые и собственные отчёты; доступ по ролям и строкам данных [С1]")
    }
}

System_Ext(new_business, "Системы новых направлений", "Фармацевтика и производство медоборудования; собственные приложения и базы [С3]")

Rel(operator, desktop, "Работает", "Интерфейс приложения")
Rel(desktop, med_api, "Ведёт приём, запрашивает данные", "HTTPS/JSON")
Rel(med_api, med_db, "Читает и сохраняет", "SQL/TLS")
Rel(med_api, images, "Читает и сохраняет снимки", "S3 API/HTTPS")
Rel_R(med_api, ai_api, "Передаёт задание и ссылку на снимок; получает результат", "HTTPS/JSON")
Rel(med_api, fin_api, "Передаёт номер заказа и сумму; получает статус оплаты", "HTTPS/JSON")
Rel(ai_api, images, "Читает снимок по временной ссылке", "HTTPS")
Rel(fin_api, fin_db, "Читает и сохраняет", "SQL/TLS")
Rel(ai_api, ai_db, "Читает и сохраняет", "SQL/TLS")
Rel(office_api, office_db, "Читает и сохраняет", "SQL/TLS")
Rel(office_api, new_business, "Передаёт заказы и заявки; получает сведения о поставках и обслуживании [С3]", "HTTPS/JSON")

Rel(med_api, loader, "Выгружает число услуг и выручку; без данных пациентов", "HTTPS/JSON")
Rel(fin_api, loader, "Выгружает разрешённые финансовые показатели", "HTTPS/JSON")
Rel(ai_api, loader, "Выгружает использование и затраты; без результатов диагностики", "HTTPS/JSON")
Rel(office_api, loader, "Выгружает корпоративные показатели", "HTTPS/JSON")
Rel(new_business, loader, "Выгружает показатели по общему контракту [С3]", "HTTPS/JSON")
Rel(loader, dwh, "Обновляет данные и отчётные витрины", "SQL/TLS")
Rel(bi, dwh, "Запрашивает разрешённые наборы данных", "SQL/ODBC, TLS")
Rel(analyst, bi, "Смотрит и создаёт отчёты", "HTTPS")

Lay_R(ai_api, fin_api)
Lay_R(fin_api, office_api)

note bottom of dwh
  Медицинские карты, истории болезни, исследования,
  снимки и результаты диагностики ИИ сюда не поступают.
end note

legend bottom
  Серверные контейнеры размещаются в облаке, среды направлений изолированы.
  С1 — быстрая отчётность; С2 — независимое развитие; С3 — новые бизнесы.
  С4 — стабильность: резервирование API и БД, копии в другом разрешённом регионе.
  Доступ к API и данным по ролям, шифрование и журналирование обращений.
endlegend

@enduml
